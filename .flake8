[flake8]
max-line-length = 120

# Black can yield formatted code that triggers these Flake8 warnings.
ignore =

    # Line break occurred before a binary operator (W503) - https://www.flake8rules.com/rules/W503.html
    W503

    # Line break occurred after a binary operator (W504) - https://www.flake8rules.com/rules/W504.html
    W504

    # E501 line too long (151 > 120 characters) - https://www.flake8rules.com/rules/E501.html
    E501

per-file-ignores =

    # F401 module imported but unused - https://www.flake8rules.com/rules/F401.html
    tests/**.py: F401

    # E402 module level import not at top of file - https://www.flake8rules.com/rules/E402.html
    src/threatpatrols_action/cli/__init__.py: E402

    # F401 module imported but unused - https://www.flake8rules.com/rules/F401.html
    # E402 module level import not at top of file - https://www.flake8rules.com/rules/E402.html
    src/threatpatrols_action/shared/models/__init__.py: F401, E402

    # W291 trailing whitespace
    src/threatpatrols_action/cli/lib/args.py: W291
